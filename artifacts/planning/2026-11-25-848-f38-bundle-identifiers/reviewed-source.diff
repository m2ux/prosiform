+def test_a_preset_and_source_name_collision_preserves_the_published_set(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    task(tmp_path)
+    written(
+        tmp_path,
+        "guide.md",
+        DECLARED + '# Guide\n\n[⇉ Checks](task.md "checks")\n\n'
+        '[⇉ Draft](task.md "draft")\n',
+    )
