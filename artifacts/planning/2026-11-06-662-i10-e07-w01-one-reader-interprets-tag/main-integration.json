et-List Reader](https://github.com/m2ux/prosiform/pull/665) — the shared reader and its observing checks.\n","created_at":"2026-11-06T10:42:29Z","updated_at":"2026-11-06T10:42:29Z","closed_at":null,"merged_at":null,"merge_commit_sha":"8f46c3fe19572e5059889d4082106ef56837fad5","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/m2ux/prosiform/pulls/666/commits","review_comments_url":"https://api.github.com/repos/m2ux/prosiform/pulls/666/comments","review_comment_url":"https://api.github.com/repos/m2ux/prosiform/pulls/comments{/number}","comments_url":"https://api.github.com/repos/m2ux/prosiform/issues/666/comments","statuses_url":"https://api.github.com/repos/m2ux/prosiform/statuses/b0ec538dacc97ca546ad5d5d83748764f511e258","head":{"label":"m2ux:i10/e07/main","ref":"i10/e07/main","sha":"b0ec538dacc97ca546ad5d5d83748764f511e258","user":{"login":"m2ux","id":176900785,"node_id":"U_kgDOCotKsQ","avatar_url":"https://avatars.githubusercontent.com/u/176900785?v=4","gravatar_id":"","url":"https://api.github.com/users/m2ux","html_url":"https://github.com/m2ux","followers_url":"https://api.github.com/users/m2ux/followers","following_url":"https://api.github.com/users/m2ux/following{/other_user}","gists_url":"https://api.github.com/users/m2ux/gists{/gist_id}","starred_url":"https://api.github.com/users/m2ux/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/m2ux/subscriptions","organizations_url":"https://api.github.com/users/m2ux/orgs","repos_url":"https://api.github.com/users/m2ux/repos","events_url":"https://api.github.com/users/m2ux/events{/privacy}","received_events_url":"https://api.github.com/users/m2ux/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1423224592,"node_id":"R_kgDOVNSvEA","name":"prosiform","full_name":"m2ux/prosiform","private":false,"owner":{"login":"m2ux","id":176900785,"node_id":"U_kgDOCotKsQ","a